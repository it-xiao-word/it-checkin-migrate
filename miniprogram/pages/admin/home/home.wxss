.page { padding: 24rpx; }

.statbar {
  display: flex;
  align-items: center;
  background: #1F3B5A;
  border-radius: 20rpx;
  padding: 28rpx 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 59, 90, 0.18);
}
.stat-item { flex: 1; text-align: center; }
.stat-n {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
}
.stat-n.warn { color: #ff9b8f; }
.stat-l {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.66);
  margin-top: 4rpx;
}
.stat-sep { width: 1rpx; height: 44rpx; background: rgba(255, 255, 255, 0.16); }

/* 趋势 */
.spark { display: flex; align-items: flex-end; gap: 12rpx; }
.spark-col { flex: 1; display: flex; flex-direction: column; align-items: center; }
.spark-wrap {
  width: 100%;
  height: 150rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.spark-bar {
  width: 100%;
  max-width: 44rpx;
  min-height: 4rpx;
  background: #cfdcea;
  border-radius: 8rpx 8rpx 0 0;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}
.spark-bar.zero { background: #eef1f5; }
.spark-bad { width: 100%; background: #C0392B; border-radius: 6rpx 6rpx 0 0; }
.spark-n { font-size: 21rpx; color: #8a94a6; margin-top: 8rpx; line-height: 1; }
.spark-x { font-size: 20rpx; color: #a8b0bd; margin-top: 6rpx; line-height: 1; }
.spark-x.today { color: #1F3B5A; font-weight: 600; }
.spark-legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f2f5f9;
  font-size: 22rpx;
  color: #6b7585;
}
.lg-item { display: flex; align-items: center; gap: 8rpx; }
.lg-dot { width: 14rpx; height: 14rpx; border-radius: 4rpx; display: inline-block; }
.lg-dot.normal { background: #cfdcea; }
.lg-dot.bad { background: #C0392B; }

/* 宫格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.tile {
  width: calc(50% - 8rpx);
  background: #ffffff;
  border-radius: 18rpx;
  padding: 26rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 59, 90, 0.05);
}
.tile-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  background: #e8eef5;
  color: #1F3B5A;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.tile-t { font-size: 28rpx; font-weight: 600; color: #1f2329; }
.tile-d { font-size: 22rpx; color: #8a94a6; margin-top: 4rpx; }

.quick { margin-top: 8rpx; }
.foot { text-align: center; padding: 40rpx 0 30rpx; font-size: 22rpx; }

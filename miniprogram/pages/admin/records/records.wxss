.page { padding: 24rpx 24rpx 0; }

/* 筛选 */
.filter { margin-bottom: 16rpx; }
.search-input {
  background: #f5f7fa;
  border: 1rpx solid #e3e9f0;
  border-radius: 12rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
  height: 74rpx;
  margin-bottom: 16rpx;
}
.filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.date-pick {
  background: #f5f7fa;
  border: 1rpx solid #e3e9f0;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #2b3444;
  min-width: 170rpx;
  text-align: center;
}
.date-pick.ph { color: #a8b0bd; }
.switch {
  padding: 0 22rpx;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e3e9f0;
  font-size: 24rpx;
  color: #5a6474;
  margin-left: auto;
}
.switch.on { background: #C0392B; border-color: #C0392B; color: #ffffff; font-weight: 600; }
.reset { font-size: 25rpx; color: #5a7fa8; padding: 8rpx 4rpx; }

.count { padding: 4rpx 8rpx 16rpx; font-size: 23rpx; }

/* 列表 */
.rec {
  display: flex;
  gap: 18rpx;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 59, 90, 0.05);
  position: relative;
  overflow: hidden;
}
.rec-bad::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: #C0392B;
}
.rec-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 10rpx;
  background: #eef1f5;
  flex-shrink: 0;
}
.rec-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  color: #a8b0bd;
}
.rec-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.rec-loc { font-size: 28rpx; font-weight: 600; color: #1F3B5A; max-width: 55%; }
.rec-time { font-size: 21rpx; color: #8a94a6; flex-shrink: 0; }
.rec-meta {
  font-size: 23rpx;
  color: #5a6474;
  margin-top: 8rpx;
  line-height: 1.4;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.rec-tags { margin-top: auto; padding-top: 8rpx; }

.more { text-align: center; padding: 24rpx 0; font-size: 23rpx; }

.bottom-pad { height: 180rpx; }
.bottom {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -2rpx 16rpx rgba(31, 59, 90, 0.08);
}

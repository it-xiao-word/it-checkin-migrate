<view class="page">
  <view class="head">
    <view class="t36 strong c-primary">{{must ? '首次登录 · 修改密码' : '修改密码'}}</view>
    <view class="muted head-sub">{{must ? '为了账号安全，请先设置新的登录密码' : '修改成功后，其他设备上的登录会自动失效'}}</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field-l">原密码</view>
      <input class="input" password="{{true}}" placeholder="当前登录密码" placeholder-class="ph"
             value="{{oldPassword}}" bindinput="onOld" />
    </view>

    <view class="field">
      <view class="field-l">新密码</view>
      <input class="input" password="{{true}}" placeholder="至少 6 位" placeholder-class="ph"
             value="{{newPassword}}" bindinput="onNew" />
    </view>

    <view class="field">
      <view class="field-l">确认新密码</view>
      <input class="input" password="{{true}}" placeholder="再输入一次" placeholder-class="ph"
             value="{{confirm}}" bindinput="onConfirm" bindconfirm="submit" />
    </view>

    <view class="err" wx:if="{{err}}">{{err}}</view>

    <button class="btn btn-primary btn-block" bindtap="submit"
            loading="{{loading}}" disabled="{{loading}}">
      {{loading ? '保存中…' : '保存并继续'}}
    </button>
  </view>
</view>

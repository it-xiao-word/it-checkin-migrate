.boot {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.boot-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
  background: #1F3B5A;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 59, 90, 0.24);
}
.boot-tip { margin-top: 6rpx; }

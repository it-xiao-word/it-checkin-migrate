.login {
  min-height: 100vh;
  padding: 120rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 30rpx;
  background: #1F3B5A;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 59, 90, 0.22);
}

.brand-sub { margin-top: 10rpx; }

.err {
  background: #fdecea;
  color: #C0392B;
  font-size: 26rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.tip {
  margin-top: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.foot {
  margin-top: auto;
  padding-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
}

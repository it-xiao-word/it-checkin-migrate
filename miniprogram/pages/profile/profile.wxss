.page { padding: 24rpx; }

.hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #1F3B5A;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 59, 90, 0.2);
}
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hero-body { flex: 1; min-width: 0; }
.hero-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
}
.hero-sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
}
.role {
  font-size: 21rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  flex-shrink: 0;
}
.role-admin { background: #d9a441; color: #3a2a00; font-weight: 600; }

.group { margin-bottom: 8rpx; }
.group-t {
  font-size: 24rpx;
  color: #8a94a6;
  padding: 8rpx 8rpx 14rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-top: 1rpx solid #f2f5f9;
}
.menu-item:first-child { border-top: none; }
.menu-t {
  font-size: 29rpx;
  color: #1f2329;
  font-weight: 500;
}
.arrow {
  font-size: 40rpx;
  color: #c3cbd6;
  line-height: 1;
  margin-left: 12rpx;
}

.logout { margin-top: 32rpx; }
.foot {
  text-align: center;
  padding: 48rpx 0 40rpx;
  font-size: 22rpx;
}
